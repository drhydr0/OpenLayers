<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".LayersApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Layers">

        <activity
            android:name=".ui.ProjectsActivity"
            android:exported="false" />

        <!-- Keeps the original launcher component name, so home-screen icons survive the rename. -->
        <activity-alias
            android:name=".ui.StartActivity"
            android:exported="true"
            android:targetActivity=".ui.ProjectsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.EditorActivity"
            android:exported="false"
            android:parentActivityName=".ui.ProjectsActivity" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:parentActivityName=".ui.ProjectsActivity" />
    </application>
</manifest>
