<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/editor_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_back_description"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:id="@+id/editor_save_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/editor_undo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_undo"
            android:enabled="false"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/editor_redo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_redo"
            android:enabled="false"
            android:src="@drawable/ic_redo" />

        <ImageButton
            android:id="@+id/editor_export"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_export"
            android:src="@drawable/ic_export" />

        <ImageButton
            android:id="@+id/editor_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_more"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Shown while selecting an area: says what is being drawn and copied, with the actions. -->
    <LinearLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/editor_area_bar"
        tools:ignore="ButtonOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/layer_row_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editor_area_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/editor_area_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/area_cancel_description"
            android:minHeight="48dp"
            android:text="@string/area_cancel" />

        <Button
            android:id="@+id/editor_area_copy"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/area_copy_description"
            android:minHeight="48dp"
            android:text="@string/area_copy" />
    </LinearLayout>

    <!-- Shown while editing inside a group: names it and offers the way out. -->
    <LinearLayout
        android:id="@+id/editor_scope_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/layer_row_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editor_scope_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="start"
            android:maxLines="1"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/editor_scope_exit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/scope_exit_description"
            android:minHeight="48dp"
            android:text="@string/scope_exit" />
    </LinearLayout>

    <io.github.drhydr0.layers.render.DocumentView
        android:id="@+id/editor_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Shares the screen with the canvas so both stay usable; toggled by the Layers button. -->
    <FrameLayout
        android:id="@+id/editor_layers_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:background="?android:attr/colorBackground"
        android:visibility="gone">

        <!-- Its own strip above the list (the list starts below it), so it never covers a layer. -->
        <Button
            android:id="@+id/editor_multiselect"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:background="@drawable/layer_row_background"
            android:contentDescription="@string/editor_multiselect_off"
            android:paddingHorizontal="16dp"
            android:text="@string/editor_multiselect" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/editor_layers_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp" />

        <TextView
            android:id="@+id/editor_layers_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/layers_empty" />
    </FrameLayout>

    <!-- Actions for the current selection; hidden when nothing is selected. -->
    <LinearLayout
        android:id="@+id/editor_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editor_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/editor_edit_text"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/selection_edit_description"
            android:minHeight="48dp"
            android:text="@string/selection_edit"
            android:visibility="gone" />

        <Button
            android:id="@+id/editor_selection_actions"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/selection_actions_description"
            android:minHeight="48dp"
            android:text="@string/selection_actions" />

        <Button
            android:id="@+id/editor_delete_selection"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/selection_delete_description"
            android:minHeight="48dp"
            android:text="@string/selection_delete" />
    </LinearLayout>

    <!-- While nudging, only the canvas and these arrows show, so every pixel step is visible. -->
    <LinearLayout
        android:id="@+id/editor_nudge_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/editor_nudge_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/nudge_cancel" />

        <Button
            android:id="@+id/editor_nudge_left"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/nudge_left_description"
            android:minHeight="56dp"
            android:text="@string/nudge_left" />

        <Button
            android:id="@+id/editor_nudge_up"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/nudge_up_description"
            android:minHeight="56dp"
            android:text="@string/nudge_up" />

        <Button
            android:id="@+id/editor_nudge_down"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/nudge_down_description"
            android:minHeight="56dp"
            android:text="@string/nudge_down" />

        <Button
            android:id="@+id/editor_nudge_right"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/nudge_right_description"
            android:minHeight="56dp"
            android:text="@string/nudge_right" />

        <Button
            android:id="@+id/editor_nudge_step"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/nudge_step_description"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/editor_nudge_done"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/nudge_done" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editor_main_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/editor_add"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/editor_add_description"
            android:minHeight="56dp"
            android:text="@string/editor_add" />

        <Button
            android:id="@+id/editor_select_area"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/editor_select_area_description"
            android:minHeight="56dp"
            android:text="@string/editor_select_area" />

        <Button
            android:id="@+id/editor_layers"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/editor_layers_description"
            android:minHeight="56dp"
            android:text="@string/editor_layers" />
    </LinearLayout>
</LinearLayout>
