<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/area_shape_label"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <RadioGroup
            android:id="@+id/area_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/area_shape_rect"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/area_shape_rect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/area_shape_rect" />

            <RadioButton
                android:id="@+id/area_shape_lasso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/area_shape_lasso" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/area_scope_label"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <RadioGroup
            android:id="@+id/area_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/area_scope_canvas">

            <RadioButton
                android:id="@+id/area_scope_canvas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/area_scope_canvas" />

            <RadioButton
                android:id="@+id/area_scope_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/area_scope_active" />

            <RadioButton
                android:id="@+id/area_scope_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/area_scope_selected" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/area_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="@string/area_include_background" />
    </LinearLayout>
</ScrollView>
