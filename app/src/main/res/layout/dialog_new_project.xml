<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/new_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/new_project_name_hint"
            android:inputType="textCapSentences"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/new_project_size_label"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <RadioGroup
            android:id="@+id/new_project_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/size_square">

            <RadioButton
                android:id="@+id/size_square"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/size_square" />

            <RadioButton
                android:id="@+id/size_portrait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/size_portrait" />

            <RadioButton
                android:id="@+id/size_story"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/size_story" />

            <RadioButton
                android:id="@+id/size_landscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/size_landscape" />

            <RadioButton
                android:id="@+id/size_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/size_custom" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/new_project_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/new_project_width"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/new_project_width_hint"
                android:inputType="number"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/new_project_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/new_project_height_hint"
                android:inputType="number"
                android:minHeight="48dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/new_project_background_label"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <RadioGroup
            android:id="@+id/new_project_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/background_white">

            <RadioButton
                android:id="@+id/background_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/background_white" />

            <RadioButton
                android:id="@+id/background_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/background_black" />

            <RadioButton
                android:id="@+id/background_transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/background_transparent" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
